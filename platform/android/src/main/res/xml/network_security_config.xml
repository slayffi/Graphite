<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is only needed for the local streaming server (127.0.0.1) and the LAN remote-control
     channel, which is end-to-end encrypted with AES-GCM at the application level. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
